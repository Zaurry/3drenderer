{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "RENDERER_NATIVE_ARCH": "OFF",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "default",
      "displayName": "Default",
      "description": "Daily build; enables CUDA when a compiler is available and uses the native GPU architecture.",
      "inherits": "base",
      "cacheVariables": {
        "RENDERER_CUDA": "AUTO"
      }
    },
    {
      "name": "no-cuda",
      "displayName": "No CUDA",
      "description": "Builds scene/document, tests, and the OpenGL viewer without CUDA Path.",
      "inherits": "base",
      "cacheVariables": {
        "RENDERER_CUDA": "OFF"
      }
    },
    {
      "name": "dxr-no-cuda",
      "displayName": "DXR without CUDA",
      "description": "Windows native DXR with the pinned DirectX, RTXDI, NRD, and Streamline SDKs.",
      "inherits": "no-cuda",
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"},
      "cacheVariables": {"RENDERER_DXR": "ON"}
    },
    {
      "name": "dxr-off",
      "displayName": "No DXR or CUDA",
      "inherits": "no-cuda",
      "cacheVariables": {"RENDERER_DXR": "OFF"}
    },
    {
      "name": "cuda-native",
      "displayName": "CUDA Native",
      "description": "Requires CUDA and compiles for the GPU installed on the build host.",
      "inherits": "base",
      "cacheVariables": {
        "RENDERER_CUDA": "ON",
        "CMAKE_CUDA_ARCHITECTURES": "native"
      }
    }
  ],
  "buildPresets": [
    {"name": "dxr-no-cuda-release", "configurePreset": "dxr-no-cuda", "configuration": "Release", "jobs": 4},
    {"name": "dxr-off-release", "configurePreset": "dxr-off", "configuration": "Release", "jobs": 4},
    {
      "name": "default-release",
      "configurePreset": "default",
      "configuration": "Release",
      "jobs": 4
    },
    {
      "name": "no-cuda-release",
      "configurePreset": "no-cuda",
      "configuration": "Release",
      "jobs": 4
    },
    {
      "name": "cuda-native-release",
      "configurePreset": "cuda-native",
      "configuration": "Release",
      "jobs": 4
    }
  ],
  "testPresets": [
    {"name": "dxr-no-cuda-release", "configurePreset": "dxr-no-cuda", "configuration": "Release", "output": {"outputOnFailure": true}, "execution": {"jobs": 4, "noTestsAction": "error"}},
    {"name": "dxr-off-release", "configurePreset": "dxr-off", "configuration": "Release", "output": {"outputOnFailure": true}, "execution": {"jobs": 4, "noTestsAction": "error"}},
    {
      "name": "default-release",
      "configurePreset": "default",
      "configuration": "Release",
      "output": {"outputOnFailure": true},
      "execution": {"jobs": 4, "noTestsAction": "error"}
    },
    {
      "name": "no-cuda-release",
      "configurePreset": "no-cuda",
      "configuration": "Release",
      "output": {"outputOnFailure": true},
      "execution": {"jobs": 4, "noTestsAction": "error"}
    },
    {
      "name": "cuda-native-release",
      "configurePreset": "cuda-native",
      "configuration": "Release",
      "output": {"outputOnFailure": true},
      "execution": {"jobs": 4, "noTestsAction": "error"}
    }
  ]
}
